# scripts/qa/phase-17.env.example

# Local API by default. Remote staging requires QA_ALLOW_REMOTE=true.
QA_API_ORIGIN=http://localhost:10000

# Existing platform account created through the secure bootstrap flow.
QA_PLATFORM_IDENTIFIER=replace-with-platform-username
QA_PLATFORM_PASSWORD=replace-with-platform-password

# Required destructive-test confirmation.
QA_CONFIRMATION=RUN_CHOIR_PHASE_17_TESTS
QA_ALLOW_REMOTE=false

# Set true to keep the generated QA choirs active for manual RN testing.
QA_KEEP_FIXTURES=false
