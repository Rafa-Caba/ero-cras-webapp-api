# scripts/qa/platform-profile-context.env.example

API_BASE_URL=http://localhost:10000/api
PLATFORM_IDENTIFIER=rafacaba
PLATFORM_PASSWORD=replace-with-your-local-password

# Optional. When omitted, the script uses the first active choir returned by the API.
PREFERRED_CHOIR_ID=

# Keep false for normal local QA. Set true only when you intentionally test a remote non-production environment.
ALLOW_REMOTE_QA=false
