# .env.development.example
NODE_ENV=development
PORT=10000
MONGO_URI=mongodb://127.0.0.1:27017/ero_cras_development
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://10.0.2.2:10000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
JWT_ISSUER=ero-cras-api
JWT_AUDIENCE=ero-cras-clients
ALLOW_SUPER_ADMIN_BOOTSTRAP=true
SUPER_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
ALLOW_DATABASE_RESET=false
DATABASE_RESET_CONFIRMATION=

# Existing media integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
